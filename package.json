{
  "name": "room-ready",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts --host 0.0.0.0",
    "dev:server": "cargo run --manifest-path server/Cargo.toml",
    "build": "vite build --config frontend/vite.config.ts",
    "test": "vitest run --config frontend/vite.config.ts && cargo test --manifest-path server/Cargo.toml",
    "preview": "vite preview --config frontend/vite.config.ts --host 0.0.0.0"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
